# ==============================
# GIT IGNORE - KEEP SECRETS SAFE
# ==============================

# Environment variables (NEVER commit!)
.env
.env.local
.env.production

# Node modules
node_modules/

# Uploaded resume files (ephemeral on Render)
uploads/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Build output
dist/
build/

# Batch scripts (may contain secrets)
*.bat

# ─── Temp / Debug / Test Scripts ───────────────────────────────
# These are one-off debugging files, not production code
test-*.js
fix_resumes.js
check-models.js
cleanup.js
debug-key.js
find-model.js
list-models-raw.js
*.test.pdf
test-resume.pdf

# ─── Stale Directories ──────────────────────────────────────────
color palatte/
scratch/

# ─── Package manager lock (optional but keep package-lock.json) ─
# Keep package-lock.json for reproducible installs
