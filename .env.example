# ============================================
# AI RESUME SCREENING APP - ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ─── MongoDB Atlas ───────────────────────────
# Get your connection string from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── App ─────────────────────────────────────
appName=AI Resume Screener
PORT=3000

# ─── Gemini AI ───────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── Nodemailer (Gmail) ──────────────────────
# Use a Gmail App Password (not your real password)
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="AI Resume Screener" <your_email@gmail.com>

# ─── Authentication ──────────────────────────
# Generate a strong random string: https://randomkeygen.com
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# ─── CORS (Production Only) ──────────────────
# Set this to your Vercel deployment URL in Render's environment variables
# Example: https://ai-resume-app.vercel.app
FRONTEND_URL=
