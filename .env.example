# ============================================
# AI RESUME SCREENING APP - ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ─── MongoDB Atlas ───────────────────────────
# Get your connection string from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
PORT=3000

# ─── AI Provider (Primary: Groq) ─────────────
# Get your Groq API key from: https://console.groq.com
GROQ_API_KEY=

# ─── AI Provider (Backup: OpenRouter) ────────
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── Nodemailer (Gmail) ──────────────────────
# Use a Gmail App Password (NOT your real password)
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_FROM="SmartHire" <your_email@gmail.com>

# ─── Authentication ──────────────────────────
# Generate a strong random string: https://randomkeygen.com
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# ─── CORS / Origins ──────────────────────────
# Comma-separated list of allowed frontend origins
# Example for local dev: http://localhost:3000,http://localhost:5173
# Example for production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_MAX=1000

# ─── Admin Reset Script (reset-admin.js) ─────
# Only needed when running: node reset-admin.js
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=YourStrongPassword123!
